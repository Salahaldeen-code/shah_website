# Public site URL used for metadata, sitemap, and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site identity (fill in when content is ready)
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_DESCRIPTION=

# Payload CMS
PAYLOAD_SECRET=replace-with-a-long-random-string

# Database — Neon / Vercel Postgres in production.
# When POSTGRES_URL or DATABASE_URL is set, Payload uses Postgres.
# If unset, Payload falls back to local SQLite at ./payload.db
POSTGRES_URL=
# Example (Neon):
# POSTGRES_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# DATABASE_URL=
# SQLITE_URL=file:./payload.db

# Cloudinary media storage — takes priority over Vercel Blob when all three are set.
# Find these under Cloudinary → Settings → API Keys (cloud name is the product environment).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder every upload is nested under (default: psr)
CLOUDINARY_FOLDER=psr

# Vercel Blob media storage (fallback when Cloudinary vars are absent)
BLOB_READ_WRITE_TOKEN=

# Gmail SMTP for membership registration emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=
MAIL_FROM_NAME=PSR Member Portal

# Deploy checklist: see README.md → "Deploy on Vercel"
